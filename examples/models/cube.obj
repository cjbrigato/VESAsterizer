# Simple cube centered at origin
# 8 vertices
v -1.0 -1.0  1.0
v  1.0 -1.0  1.0
v  1.0  1.0  1.0
v -1.0  1.0  1.0
v -1.0 -1.0 -1.0
v  1.0 -1.0 -1.0
v  1.0  1.0 -1.0
v -1.0  1.0 -1.0

# 12 triangles (6 faces * 2 triangles each)
# Front face
f 1 2 3
f 1 3 4

# Back face
f 6 5 8
f 6 8 7

# Top face
f 4 3 7
f 4 7 8

# Bottom face
f 5 6 2
f 5 2 1

# Right face
f 2 6 7
f 2 7 3

# Left face
f 5 1 4
f 5 4 8
